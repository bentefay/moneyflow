{
    "permissions": {
        "allow": [
            "Skill(crdt)",
            "Bash(. ~/.profile)",
            "Bash(. ~/.bashrc)",
            "Bash(run tsc:*)",
            "Bash(run test:*)",
            "Bash(run lint:*)",
            "Bash(run check:*)",
            "Bash(run format:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(bun run playwright test:*)",
            "Bash(run browser:*)",
            "Bash(find:*)",
            "Bash(tail:*)",
            "Bash(bun run vitest:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // .tool_input.file_path' | xargs \"$CLAUDE_PROJECT_DIR\"/cli/bin/run format >/dev/null 2>&1 || true"
                    }
                ]
            }
        ]
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
    }
}
