# =============================================================================
# MoneyFlow Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
#
# For local development, run `supabase start` and use the outputted values.
# -----------------------------------------------------------------------------

# Supabase Project URL
# Local dev: http://127.0.0.1:54321
# Production: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (sb_publishable_..., safe to expose in the browser)
# It only reaches what RLS allows. The value below is the fixed key every local Supabase stack uses.
# Production: the project's publishable key from Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Supabase secret key (sb_secret_..., server-only; bypasses RLS)
# Never prefix it with NEXT_PUBLIC_. Local dev: the local stack's fixed secret key, printed by
#   docker exec supabase_kong_moneyflow grep -oE 'sb_secret_[A-Za-z0-9_-]+' /home/kong/kong.yml
# Production: a dedicated secret key for the deployment, from Settings > API Keys.
SUPABASE_SECRET_KEY=your-local-secret-key

# Server-only tenant JWT secret used to mint 60-second vault-scoped Realtime credentials.
# Local dev: leave unset. `run dev`, `run start` and the tests read it from the running local
# Realtime container. Set it only to override that.
# Production: use the project's legacy JWT secret; never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_JWT_SECRET=replace-with-at-least-32-characters

# -----------------------------------------------------------------------------
# Optional: CAPTCHA Configuration
# -----------------------------------------------------------------------------
# Bot protection for registration. Supports hCaptcha or Cloudflare Turnstile.
# If not configured, CAPTCHA verification is skipped.
# -----------------------------------------------------------------------------

# hCaptcha (https://dashboard.hcaptcha.com)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
# HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# -----------------------------------------------------------------------------
# Optional: Analytics
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# Enable debug logging (do not use in production)
# NEXT_PUBLIC_DEBUG=true
